<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
    Shop restriction for POS users: when "Allowed shops" is filled on the
    user, they only see those points of sale, their sessions and orders.

    GOTCHA: point_of_sale.group_pos_manager implies group_pos_user, so a
    manager is also a member of group_pos_user and would be caught by the
    restrictive rule. Group rules are OR-ed together, hence the explicit
    "see everything" rules for managers below.
    -->
    <record id="rule_pos_config_allowed_shops" model="ir.rule">
        <field name="name">POS users: allowed shops</field>
        <field name="model_id" ref="point_of_sale.model_pos_config"/>
        <field name="domain_force">[('id', 'in', user.ke_pos_config_ids.ids)] if user.ke_pos_config_ids else []</field>
        <field name="groups" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
    </record>
    <record id="rule_pos_session_allowed_shops" model="ir.rule">
        <field name="name">POS users: sessions of allowed shops</field>
        <field name="model_id" ref="point_of_sale.model_pos_session"/>
        <field name="domain_force">[('config_id', 'in', user.ke_pos_config_ids.ids)] if user.ke_pos_config_ids else []</field>
        <field name="groups" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
    </record>
    <record id="rule_pos_order_allowed_shops" model="ir.rule">
        <field name="name">POS users: orders of allowed shops</field>
        <field name="model_id" ref="point_of_sale.model_pos_order"/>
        <field name="domain_force">[('config_id', 'in', user.ke_pos_config_ids.ids)] if user.ke_pos_config_ids else []</field>
        <field name="groups" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
    </record>

    <record id="rule_pos_config_manager_all" model="ir.rule">
        <field name="name">POS managers: all shops</field>
        <field name="model_id" ref="point_of_sale.model_pos_config"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('point_of_sale.group_pos_manager'))]"/>
    </record>
    <record id="rule_pos_session_manager_all" model="ir.rule">
        <field name="name">POS managers: all sessions</field>
        <field name="model_id" ref="point_of_sale.model_pos_session"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('point_of_sale.group_pos_manager'))]"/>
    </record>
    <record id="rule_pos_order_manager_all" model="ir.rule">
        <field name="name">POS managers: all orders</field>
        <field name="model_id" ref="point_of_sale.model_pos_order"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('point_of_sale.group_pos_manager'))]"/>
    </record>
</odoo>
