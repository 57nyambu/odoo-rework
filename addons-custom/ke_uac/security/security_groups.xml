<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 19: groups belong to a privilege (res.groups.privilege), no
         longer directly to a module category. -->
    <record id="res_groups_privilege_ke_retail" model="res.groups.privilege">
        <field name="name">Kenya retail role</field>
        <field name="sequence">22</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <record id="group_ke_cashier" model="res.groups">
        <field name="name">Cashier</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_ke_retail"/>
        <field name="comment">Sells at the shops listed in "Allowed shops" on the user.</field>
        <field name="implied_ids" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
    </record>

    <record id="group_ke_branch_manager" model="res.groups">
        <field name="name">Branch Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_ke_retail"/>
        <field name="comment">Runs a branch: all POS operations, stock and purchases.</field>
        <field name="implied_ids" eval="[
            (4, ref('group_ke_cashier')),
            (4, ref('point_of_sale.group_pos_manager')),
            (4, ref('stock.group_stock_manager')),
            (4, ref('purchase.group_purchase_user')),
        ]"/>
    </record>
</odoo>
