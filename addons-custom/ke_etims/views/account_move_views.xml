<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_ke_etims" model="ir.ui.view">
        <field name="name">account.move.form.ke.etims</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="ke_etims_show_send_button" invisible="1"/>
                <button name="action_ke_etims_send" type="object" string="Send to eTIMS"
                        class="btn-secondary" invisible="not ke_etims_show_send_button"
                        groups="account.group_account_invoice"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="after">
                <div class="alert alert-danger mb-2" role="alert"
                     invisible="ke_etims_state != 'error'">
                    <strong>eTIMS transmission failed.</strong>
                    It will be retried automatically.
                    <field name="ke_etims_error" readonly="1" class="d-block"/>
                </div>
                <div class="alert alert-warning mb-2" role="alert"
                     invisible="not ke_etims_training">
                    Signed in eTIMS <strong>training mode</strong>: this is not a valid tax invoice.
                </div>
            </xpath>
            <xpath expr="//page[@name='other_info']" position="before">
                <page string="eTIMS" name="ke_etims"
                      invisible="move_type not in ('out_invoice', 'out_refund')">
                    <group>
                        <group string="KRA eTIMS">
                            <field name="ke_etims_state" widget="badge"
                                   decoration-success="ke_etims_state == 'sent'"
                                   decoration-warning="ke_etims_state == 'to_send'"
                                   decoration-danger="ke_etims_state == 'error'"/>
                            <field name="ke_etims_invoice_number"/>
                            <field name="ke_etims_scu_id"/>
                            <field name="ke_etims_receipt_number"/>
                            <field name="ke_etims_signed_at"/>
                            <field name="ke_etims_training" invisible="not ke_etims_training"/>
                        </group>
                        <group string="Signature">
                            <field name="ke_etims_internal_data"/>
                            <field name="ke_etims_signature"/>
                            <field name="ke_etims_qr_data"/>
                            <field name="ke_etims_attempts"/>
                            <field name="ke_etims_last_attempt_at"/>
                        </group>
                    </group>
                    <group string="Raw response" groups="base.group_system">
                        <field name="ke_etims_raw_response" nolabel="1" colspan="2"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_out_invoice_tree_ke_etims" model="ir.ui.view">
        <field name="name">account.out.invoice.list.ke.etims</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='status_in_payment']" position="after">
                <field name="ke_etims_state" optional="show" widget="badge" string="eTIMS"
                       decoration-success="ke_etims_state == 'sent'"
                       decoration-warning="ke_etims_state == 'to_send'"
                       decoration-danger="ke_etims_state == 'error'"/>
                <field name="ke_etims_invoice_number" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_invoice_filter_ke_etims" model="ir.ui.view">
        <field name="name">account.move.search.ke.etims</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='late']" position="after">
                <separator/>
                <filter name="ke_etims_pending" string="eTIMS pending"
                        domain="[('ke_etims_state', 'in', ('to_send', 'error'))]"/>
                <filter name="ke_etims_failed" string="eTIMS errors"
                        domain="[('ke_etims_state', '=', 'error')]"/>
            </xpath>
        </field>
    </record>

    <record id="action_ke_etims_send_moves" model="ir.actions.server">
        <field name="name">Send to eTIMS</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('account.group_account_invoice'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.action_ke_etims_send()</field>
    </record>
</odoo>
