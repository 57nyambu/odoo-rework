<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_ke_etims" model="ir.ui.view">
        <field name="name">account.move.form.ke.etims</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="eTIMS"
                       invisible="move_type not in ('out_invoice', 'out_refund')">
                    <field name="ke_etims_invoice_number" readonly="1"/>
                    <field name="ke_etims_qr_code" readonly="1"/>
                    <field name="ke_etims_submitted_at" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
