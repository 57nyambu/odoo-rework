<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_ke_etims" model="ir.ui.view">
        <field name="name">product.template.form.ke.etims</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='invoicing']" position="inside">
                <group name="ke_etims" string="KRA eTIMS">
                    <group>
                        <field name="ke_etims_item_class_code"/>
                        <field name="ke_etims_product_type"/>
                        <field name="ke_etims_item_code"/>
                    </group>
                    <group>
                        <field name="ke_etims_packaging_unit"/>
                        <field name="ke_etims_quantity_unit"/>
                        <field name="ke_etims_origin_country_id" options="{'no_create': True}"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
