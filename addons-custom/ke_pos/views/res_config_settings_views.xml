<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ke_pos" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ke.pos</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_payment_section']" position="after">
                <block title="Kenya" id="ke_pos_section">
                    <setting id="ke_lipa_na_mpesa" string="Lipa na M-Pesa on receipts"
                             help="Tell customers where to pay with M-Pesa. Filled in from the M-Pesa payment method; leave empty to hide.">
                        <field name="pos_ke_lipa_na_mpesa_text" placeholder="Lipa na M-Pesa - Buy Goods Till No. 5123456"/>
                        <div>
                            <button name="%(ke_mpesa.action_ke_mpesa_account)d" icon="oi-arrow-right"
                                    type="action" string="M-Pesa accounts" class="btn-link"
                                    groups="ke_mpesa.group_mpesa_manager"/>
                        </div>
                    </setting>
                    <setting id="ke_etims_wait" string="Print eTIMS details on receipts"
                             help="Sign each sale with KRA eTIMS before printing the receipt (CU invoice number and QR code).">
                        <field name="pos_ke_etims_wait_for_signature"/>
                    </setting>
                    <setting id="ke_mpesa_force_done" string="Allow forcing M-Pesa payments"
                             help="Let cashiers accept an M-Pesa payment line without Safaricom's confirmation (not recommended).">
                        <field name="pos_ke_mpesa_allow_force_done"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
