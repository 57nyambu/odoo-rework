<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mpesa_transaction_list" model="ir.ui.view">
        <field name="name">mpesa.transaction.list</field>
        <field name="model">mpesa.transaction</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/>
                <field name="phone"/>
                <field name="amount"/>
                <field name="state"/>
                <field name="mpesa_receipt_number"/>
            </list>
        </field>
    </record>

    <record id="action_mpesa_transaction" model="ir.actions.act_window">
        <field name="name">M-Pesa transactions</field>
        <field name="res_model">mpesa.transaction</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_mpesa_transaction"
              name="M-Pesa transactions"
              parent="point_of_sale.menu_point_of_sale_global_settings"
              action="action_mpesa_transaction"
              sequence="50"/>
</odoo>
