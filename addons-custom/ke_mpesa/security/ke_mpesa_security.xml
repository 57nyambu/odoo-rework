<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_mpesa" model="res.groups.privilege">
        <field name="name">M-Pesa</field>
        <field name="sequence">60</field>
        <field name="category_id" ref="base.module_category_accounting"/>
    </record>

    <record id="group_mpesa_user" model="res.groups">
        <field name="name">User: view payments</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_mpesa"/>
    </record>

    <record id="group_mpesa_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_mpesa"/>
        <field name="implied_ids" eval="[(4, ref('group_mpesa_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Accounting administrators manage M-Pesa too. -->
    <record id="account.group_account_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_mpesa_manager'))]"/>
    </record>

    <record id="rule_mpesa_account_company" model="ir.rule">
        <field name="name">M-Pesa account: multi-company</field>
        <field name="model_id" ref="model_ke_mpesa_account"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_mpesa_transaction_company" model="ir.rule">
        <field name="name">M-Pesa transaction: multi-company</field>
        <field name="model_id" ref="model_ke_mpesa_transaction"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
