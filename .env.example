ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=change-me
ODOO_ADMIN_PASSWD=change-me-too

# Multi-tenancy: each tenant is a database named like its sub-domain.
# https://<tenant>.${TENANT_DOMAIN} -> database <tenant>
TENANT_DOMAIN=pos.dima.co.ke
ODOO_DBFILTER=^%d$
ODOO_WORKERS=4

# Modules installed in every new tenant (scripts/tenant.sh create).
KE_MODULES=contacts,sale_management,sale_stock,purchase_stock,point_of_sale,ke_base,ke_etims,ke_mpesa,ke_pos,ke_ecommerce_api,ke_cash_purchase,ke_uac,ke_reporting

# Where scripts/tenant.sh backup-all writes dumps.
BACKUP_DIR=/home/tom/backups/odoo-kenya
