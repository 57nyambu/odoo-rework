// Same conventions as the other pipelines (motorgarage/samta/agriconnect...):
// motorgarage-ssh credential authenticating as `tom`, sv2-host deploy host
// binding, -i "$SSH_KEY" $SSH_OPTS to avoid word-splitting, route-agnostic
// curl -s health check with no -f.
//
// Multi-tenant: every tenant database is upgraded (scripts/tenant.sh
// upgrade-all), and the health check hits one tenant host through nginx.

pipeline {
    agent any

    environment {
        APP_DIR = '/home/tom/apps/odoo-kenya'
        HEALTH_HOST = 'demo.pos.dima.co.ke'   // any existing tenant sub-domain
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Static checks') {
            steps {
                sh '''
                    set -e
                    python3 -m compileall -q addons-custom
                    for f in $(find addons-custom -name '*.xml'); do
                        python3 -c "import sys, xml.dom.minidom; xml.dom.minidom.parse(sys.argv[1])" "$f"
                    done
                '''
            }
        }

        stage('Deploy + upgrade all tenants + health check') {
            steps {
                withCredentials([
                    sshUserPrivateKey(credentialsId: 'motorgarage-ssh', keyFileVariable: 'SSH_KEY'),
                    string(credentialsId: 'sv2-host', variable: 'DEPLOY_HOST')
                ]) {
                    sh '''
                        set -e
                        SSH_OPTS="-o StrictHostKeyChecking=no"

                        ssh -i "$SSH_KEY" $SSH_OPTS tom@"$DEPLOY_HOST" "
                            set -e
                            cd $APP_DIR
                            git pull origin main
                            bash scripts/render-config.sh
                            docker compose -f docker-compose.prod.yml pull
                            docker compose -f docker-compose.prod.yml up -d
                            bash scripts/tenant.sh backup-all
                            bash scripts/tenant.sh upgrade-all
                            docker compose -f docker-compose.prod.yml restart odoo
                        "

                        STATUS=$(ssh -i "$SSH_KEY" $SSH_OPTS tom@"$DEPLOY_HOST" \
                            "curl -s -o /dev/null -w '%{http_code}' --resolve $HEALTH_HOST:443:127.0.0.1 https://$HEALTH_HOST/web/login")

                        if [ "$STATUS" != "200" ]; then
                            echo "Health check returned $STATUS, expected 200"
                            exit 1
                        fi
                        echo "Health check OK ($STATUS)"
                    '''
                }
            }
        }
    }
}
